<?xml version="1.0" encoding="utf-8"?>
<!--
  v4.0.3 流量页：UI 与信息架构高保真对齐 flow-assistant（渐变头部 / 可展开流量详情 /
  分类汇总小卡 / 消耗测速 / 领取活动），全部用模块原生 View 在 FlowView 里动态画到
  flowRoot。这里只保留 MainActivity 直接绑定的工具条与状态行。

  数据来源不变：目标进程离屏读中国移动首页 localStorage 的明文余量缓存，
  广播回模块落盘；展示层不解密、不联网、不提交业务请求。
  消耗测速 / 领取活动是 flow-assistant 搬过来的独立原生功能，不依赖余量数据。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="24dp">

        <!-- 标题 + 一键查询 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/CardTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/flow_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFlowRefresh"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/flow_refresh"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:cornerRadius="999dp"
                app:elevation="0dp"
                app:minWidth="0dp" />
        </LinearLayout>

        <!-- 状态 / 提示 / 错误 -->
        <TextView
            android:id="@+id/flowNotify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:paddingBottom="2dp"
            android:text="@string/flow_never"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/flowAt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="2dp"
            android:paddingBottom="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <!-- 动态内容：FlowView 全量重画（Hero / 详情 / 汇总 / 账户 / 消耗 / 领取） -->
        <LinearLayout
            android:id="@+id/flowRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:text="@string/flow_hint"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>
</ScrollView>

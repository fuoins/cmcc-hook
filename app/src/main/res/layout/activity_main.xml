<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- 顶部品牌区：蓝色渐变 header + 白色标题/副标题/状态行 -->
    <LinearLayout
        android:id="@+id/appHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="26dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- 标题行：左标题，右「捐赠」小胶囊。捐赠原先在首页关于区，
             改成跟着标题栏走，任何页都能点到。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pageTitle"
                style="@style/HeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tab_home" />

            <TextView
                android:id="@+id/btnDonateTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:text="@string/donate_button"
                android:textColor="@color/header_text"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            style="@style/HeaderSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/home_subtitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot" />

            <TextView
                android:id="@+id/statusText"
                style="@style/HeaderStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/status_waiting" />
        </LinearLayout>

        <!-- 当前登录账号：切号后这里会变，数据也按账号分开存 -->
        <TextView
            android:id="@+id/accountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_header_chip"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="@string/account_unknown"
            android:textColor="@color/header_text"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- v4.32.0：脚本凭证提取。目标进程把登录态推过来后，点一下复制对应字段。
             五个并排放不下，用两行 flex 式权重均分，不引入新依赖。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnCredAppToken"
                    style="@style/HeaderChipButton"
                    android:layout_weight="1"
                    android:text="@string/cred_app_token" />

                <TextView
                    android:id="@+id/btnCredPhone"
                    style="@style/HeaderChipButton"
                    android:layout_weight="1"
                    android:text="@string/cred_phone" />

                <TextView
                    android:id="@+id/btnCredProvince"
                    style="@style/HeaderChipButton"
                    android:layout_weight="1"
                    android:text="@string/cred_province_code" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnCredCity"
                    style="@style/HeaderChipButton"
                    android:layout_weight="1"
                    android:text="@string/cred_city_code" />

                <TextView
                    android:id="@+id/btnCredCookie"
                    style="@style/HeaderChipButton"
                    android:layout_weight="1"
                    android:text="@string/cred_cookie" />

                <!-- v4.33.0：强行停止中国移动。原来这格是占位 View；
                     文案比「提取」长，放开单行限制并略缩字号，免得三等分里被裁掉。 -->
                <TextView
                    android:id="@+id/btnForceStop"
                    style="@style/HeaderChipButton"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:singleLine="false"
                    android:textSize="10sp"
                    android:text="@string/force_stop_cmcc" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 页面容器：五个页面叠放，靠显隐切换 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/pageHome"
            layout="@layout/page_home" />

        <include
            android:id="@+id/pageWelfare"
            layout="@layout/page_welfare" />

        <include
            android:id="@+id/pageFunc"
            layout="@layout/page_func" />

        <include
            android:id="@+id/pageLog"
            layout="@layout/page_log" />

        <!-- v4.0：底栏「优惠券」升级为「增强」容器页（流量 / 优惠券 两个子页 + 底部子导航）。
             容器内部再 include 原来的 page_coupon，券页所有控件 id 保持不变。 -->
        <include
            android:id="@+id/pageCoupon"
            layout="@layout/page_enhance" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- 底部导航：选中为实心胶囊 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_item"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/tab_home"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/navWelfare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_item"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/tab_welfare"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/navFunc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_item"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/tab_func"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/navLog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_item"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/tab_log"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/navCoupon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_item"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/tab_coupon"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  v4.0：底栏「优惠券」升级为「增强」容器页。
  上面是两个子页（流量 / 优惠券）叠放，底部一行子导航切换。
  被 activity_main.xml 以 android:id="@+id/pageCoupon" include —— 保留这个 id，
  MainActivity 里 pageCoupon.setVisibility 的显隐逻辑不用动。

  注意：原 page_coupon.xml 里的控件 id（couponList / btnCouponScan / ...）在
  include 之后仍能被 activity 的 findViewById 找到，券页原有逻辑完全不用改。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 子页容器：同一时刻只显示一个 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/pageFlow"
            layout="@layout/page_flow" />

        <include
            android:id="@+id/pageCouponBody"
            layout="@layout/page_coupon"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- 底部一行子导航：流量 / 优惠券 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/subFlow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_item"
            android:gravity="center"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="@string/sub_flow"
            android:textColor="@color/on_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subCoupon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_item"
            android:gravity="center"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="@string/sub_coupon"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>

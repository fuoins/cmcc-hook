<?xml version="1.0" encoding="utf-8"?>
<!--
  v3.52：按用户指定顺序重排操作按钮，并统一 6 个按钮的样式。
  顺序：跳转卡券中心 / 扫描 / 全选 / 反选 / 使用 / 一键全用（2 行 × 3 列等宽）。

  注意：couponSummary / couponAt / couponBar 三个 TextView 必须保留在布局里，
  MainActivity 会直接对它们 setText()，删掉会空指针崩溃。
  couponAt 现在用于显示「扫描于 HH:mm:ss · 耗时 X.X 秒」。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- 顶部按钮区第一行：跳转卡券中心 / 扫描 / 全选 -->
        <LinearLayout
            style="@style/CardBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCouponOpen"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/coupon_open"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:cornerRadius="999dp"
                    app:elevation="0dp"
                    app:minWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCouponScan"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/coupon_scan"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:cornerRadius="999dp"
                    app:elevation="0dp"
                    app:minWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCouponAll"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/coupon_select_all"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:cornerRadius="999dp"
                    app:elevation="0dp"
                    app:minWidth="0dp" />
            </LinearLayout>

            <!-- 第二行：反选 / 使用 / 一键全用 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCouponInvert"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/coupon_invert"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:cornerRadius="999dp"
                    app:elevation="0dp"
                    app:minWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCouponUse"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/coupon_use"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:cornerRadius="999dp"
                    app:elevation="0dp"
                    app:minWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCouponUseAll"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/coupon_use_all"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:cornerRadius="999dp"
                    app:elevation="0dp"
                    app:minWidth="0dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 扫描时刻 + 扫描耗时 -->
        <TextView
            android:id="@+id/couponAt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingTop="8dp"
            android:paddingEnd="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- v4.0.4：小米 / HyperOS 短信验证码自检入口。
             系统级「验证码安全保护」模块不能代改，只能把步骤摆到用户面前。 -->
        <TextView
            android:id="@+id/smsHelpEntry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="4dp"
            android:text="@string/sms_help_entry"
            android:textColor="@color/primary"
            android:textSize="12sp" />

        <!-- 两个功能开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp">

            <CheckBox
                android:id="@+id/cbCouponSort"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/coupon_sort_valid"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbCouponHide"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/coupon_hide_blocked"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/couponList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- v3.48 起描述文字隐藏，ID 保留是因为 MainActivity 会 setText。 -->
        <TextView
            android:id="@+id/couponSummary"
            style="@style/RowDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/couponBar"
            style="@style/RowDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>

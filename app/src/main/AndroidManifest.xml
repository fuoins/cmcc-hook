<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 券核销短信验证码自动读取：静态广播收实时短信，短信库做兜底。
         两者都是运行时权限，模块界面里会按需申请；不授权就退回手动输入。 -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <queries>
        <package android:name="com.greenpoint.android.mc10086.activity" />
        <package android:name="org.lsposed.manager" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.CmccHook">

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="中国移动 App 签到/福利中心请求抓取（第一阶段）" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedsharedprefs"
            android:value="true" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".LogReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.cmcchook.action.LOG" />
                <action android:name="com.cmcchook.action.HEARTBEAT" />
                <action android:name="com.cmcchook.action.STATE" />
                <action android:name="com.cmcchook.action.WELFARE" />
                <action android:name="com.cmcchook.action.PROBE" />
                <action android:name="com.cmcchook.action.PROBE_ACT" />
                <action android:name="com.cmcchook.action.LOGIN_LOST" />
                <action android:name="com.cmcchook.action.COUPON_LIST" />
                <action android:name="com.cmcchook.action.COUPON_PROGRESS" />
                <action android:name="com.cmcchook.action.COUPON_NEED_CODE" />
                <action android:name="com.cmcchook.action.COUPON_DONE" />
            </intent-filter>
        </receiver>

        <!-- SMS_RECEIVED 是系统受保护广播，只有系统电话进程能发，第三方伪造不了。
             不再额外声明发送方权限：部分 ROM 上它会反过来把正常广播挡掉。 -->
        <receiver
            android:name=".SmsReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".TaskAlarmReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.cmcchook.action.ALARM_TICK" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
